# Copy to .env for local development. Never commit real values.

# Must be a replica set: job booking uses transactions.
#   Local MongoDB service: run scripts/setup-local-mongo.ps1 once (as Administrator), then use the value below.
#   Production: the Atlas SRV URL, e.g. mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/fieldops
#   (Atlas clusters are already replica sets.)
MONGODB_URI=mongodb://localhost:27017/fieldops?replicaSet=rs0&directConnection=true

# Signs session tokens. 32+ random characters: openssl rand -base64 32
JWT_SECRET=

# local or cloudinary. Production must use cloudinary: Vercel has no lasting disk.
STORAGE_DRIVER=local

# Signed uploads (only when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting (optional). Empty: off in development; in production an in-memory limiter per
# server instance is used instead, which resets on restart and is not shared between instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protects /api/cron/daily
CRON_SECRET=

# Absolute links in PDFs
APP_URL=http://localhost:3000
